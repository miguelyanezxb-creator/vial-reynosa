{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vial-reynosa",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-21",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vial-reynosa-db",
      "database_id": "8c9c3c2a-692d-4026-84f8-369ba7eeacc0",
      "migrations_dir": "migraciones"
    }
  ]
}
